<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="web.OfflineSystray">
        <span t-if="this.offlinePlugin.isOffline() or this.offlinePlugin.hasScheduledCalls" class="position-relative">
        <Dropdown
            state="this.dropdown"
            navigationOptions="this.navigationOptions"
            disabled="!this.offlinePlugin.hasScheduledCalls">
            <div
                t-if="this.uiService.isSmall"
                t-on-click="() => this.offlinePlugin.checkConnection()"
                t-att-aria-description="this.pendingCount ? this.counterLabel : undefined"
                class="o_nav_entry o_offline_systray">
                    <i t-attf-class="oi me-1" t-att-data-icon="this.labelIcon"
                    role="img"
                    t-att-aria-label="this.labelText"
                    t-att-data-tooltip="this.labelText"/>
            </div>
            <button t-else=""
                t-attf-class="o_nav_entry px-2 o_tag {{ this.labelColor }} o_offline_systray"
                data-available-offline=""
                t-on-click="() => this.offlinePlugin.checkConnection()"
                t-att-aria-description="this.pendingCount ? this.counterLabel : undefined"
                data-tooltip="Click to check connection and Sync">
                <i t-attf-class="oi me-1" t-att-data-icon="this.labelIcon"/><t t-out="this.labelText"></t><i t-if="this.offlinePlugin.hasScheduledCalls" class="oi ms-2" data-icon="arrow_drop_down"/>
            </button>
            <t t-set-slot="content">
                <div class="o_offline_systray_content px-2">
                    <p t-if="this.offlinePlugin.getQueueError()" role="alert" class="text-danger" t-out="this.offlinePlugin.getQueueError()"/>
                    <t t-foreach="this.groupEntries()" t-as="entry" t-key="entry.id">
                        <div t-if="entry.name" class="o_horizontal_separator text-uppercase fw-bolder small mb-1">
                            <span t-out="entry.name"/>
                        </div>
                        <t t-foreach="entry.items" t-as="element" t-key="element.id">
                            <DropdownItem
                                onSelected="() => element.clickable and this.openView(element.entry)"
                                closingMode="element.clickable ? 'all' : 'none'"
                                class="{
                                    'pe-1': true,
                                    'px-0': true,
                                    'o_offline_pending_item': true,
                                    'border-top': !element.sameRecord,
                                    'o_cursor_auto': !element.clickable,
                                    'o_disabled_while_sync': this.offlinePlugin.syncingORM(),
                                    'mb-2': element_last,
                                 }">
                                <div t-attf-class="text-truncate {{element.error ? 'text-danger': ''}} {{ element.clickable ? '' : 'text-muted'}}" t-att-data-tooltip="element.error ?? element.displayName">
                                    <i t-if="element.error" class="oi oi-fw oi-filled o_button_icon text-danger me-1" data-icon="error"/>
                                    <span t-out="element.displayName"/>
                                </div>
                                <div
                                    class="ms-auto"
                                    t-att-data-tooltip-template="'web.OfflineSystrayTooltip'"
                                    t-att-data-tooltip-info="element.tooltip">
                                    <span t-attf-class="o_tag mw-100 o_badge badge rounded-pill {{ 'o_tag_color_' + element.status.color }}">
                                        <t class="o_tag_badge_text o_badge_text" t-out="element.status.label"/>
                                    </span>
                                </div>
                                <span class="o_offline_pending_details text-wrap">
                                    <strong t-if="!element.sameRecord" class="d-block" t-out="element.recordName"/>
                                    <span t-out="element.description"/> · <time t-out="element.timeStamp"/>
                                    <small class="d-block" t-out="element.stateLabel"/>
                                    <small t-if="element.reason" class="d-block text-danger" t-out="element.reason"/>
                                    <ul t-if="element.recoveryValues?.length" class="mb-0 ps-3 o_offline_recovery_values">
                                        <li t-foreach="element.recoveryValues" t-as="change" t-key="change[0]">
                                            <t t-out="change[0]"/>: <t t-out="change[1]"/>
                                        </li>
                                    </ul>
                                    <button t-if="element.clickable" type="button" class="btn btn-link p-0 me-2" data-available-offline="" t-on-click.stop="() => this.openView(element.entry, true)">Open</button>
                                    <button t-if="element.retryKey" type="button" class="btn btn-link p-0" data-available-offline="" t-att-disabled="this.offlinePlugin.syncingORM()" t-on-click.stop="() => this.offlinePlugin.retryPendingChange(element.retryKey)">Retry</button>
                                </span>
                                <div>
                                    <button
                                        class="oi oi-filled btn btn-link text-danger py-0" data-icon="delete"
                                        title="Discard offline changes"
                                        aria-label="Discard offline changes"
                                        t-att-disabled="this.offlinePlugin.syncingORM()"
                                        data-available-offline=""
                                        t-on-click.stop="() => this.discard(element.id)"/>
                                </div>
                            </DropdownItem>
                        </t>
                    </t>
                </div>
            </t>
        </Dropdown>
        <span t-if="this.pendingCount" class="o_offline_pending_count badge rounded-pill text-bg-primary position-absolute top-0 end-0 pe-none" aria-hidden="true" t-out="this.pendingCount"/>
        </span>
        <span aria-live="polite" aria-atomic="true" class="visually-hidden">
            <span t-if="this.announcement().alternate" t-out="this.announcement().text"/>
            <span t-else="" t-out="this.announcement().text"/>
        </span>
    </t>

    <t t-name="web.OfflineSystrayTooltip">
        <div>
            On <t t-out="this.timeStamp"/>
        </div>
        <t t-if="this.records.length">
            <div>
                Records:
                <t t-foreach="this.records" t-as="record" t-key="record_index">
                    <div>
                        - <t t-out="record"/>
                    </div>
                </t>
            </div>
        </t>
        <t t-if="this.changes">
            <div>
                <t t-if="this.records.length">Changes:</t>
                <t t-foreach="this.changes" t-as="entry" t-key="entry_index">
                    <div>
                        - <t t-out="entry[0]"/>: <t t-out="entry[1]"/><t t-if="entry[2] !== undefined"> → <t t-out="entry[2]"/></t>
                    </div>
                </t>
            </div>
        </t>
    </t>
</templates>
